#!/usr/bin/env bash
# Claude Code on free models through OmniRoute, for when the Claude plan limit is reached.
#   claude-free [claude args…]        e.g. claude-free, claude-free -c, claude-free -p "…"
# Every model alias (main, opus, sonnet, haiku, subagents) points at the OmniRoute combo, and the key
# is restricted to that combo, so no request can reach the Claude subscription connection in OmniRoute.
# One-time setup: bash ~/Documents/projects/claude-setup/claude-code/omniroute-setup.sh
set -euo pipefail

COMBO="${CLAUDE_FREE_COMBO:-free-coding}"
URL="${OMNIROUTE_URL:-http://localhost:20128}"
TOKEN_FILE="${CLAUDE_FREE_TOKEN_FILE:-$HOME/.config/claude-free/token}"

# A free session never starts another one (free-worker inside claude-free would loop).
[[ -z "${CLAUDE_FREE_ACTIVE:-}" ]] || { echo "claude-free: already on free models; do the task in this session." >&2; exit 1; }
export CLAUDE_FREE_ACTIVE=1

[[ -s "$TOKEN_FILE" ]] || { echo "claude-free: no key at $TOKEN_FILE. Run claude-code/omniroute-setup.sh first." >&2; exit 1; }
if ! curl -fs --max-time 3 "$URL/api/health" >/dev/null; then
  echo "claude-free: starting OmniRoute…" >&2
  omniroute serve --daemon --no-open >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do curl -fs --max-time 2 "$URL/api/health" >/dev/null && break; sleep 1; done
fi

exec env -u ANTHROPIC_API_KEY \
  ANTHROPIC_BASE_URL="$URL" \
  ANTHROPIC_AUTH_TOKEN="$(cat "$TOKEN_FILE")" \
  ANTHROPIC_MODEL="$COMBO" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$COMBO" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$COMBO" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$COMBO" \
  CLAUDE_CODE_SUBAGENT_MODEL="$COMBO" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_FREE_CONTEXT:-256000}" \
  claude "$@"
