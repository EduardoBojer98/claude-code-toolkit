#!/usr/bin/env bash
# One-shot prompt to a local Ollama model: private (nothing leaves the device) and 0 plan usage.
# For read-only work on small inputs: summarise a file/log/diff, draft text, classify. It cannot edit files
# or run tools, and a 4B model can be wrong: check anything you rely on.
#   local-llm "Summarise this log in 5 bullets" < build.log
#   git diff | local-llm -m code "List what changed, one line per file"
# -m picks the model: general (default, qwen3.5:4b: digests of logs/test output, extraction),
#    code (qwen2.5-coder:3b: diffs, code, snippets; fastest, fits the GPU), write (phi4-mini: prose drafts),
#    or any pulled model name. LOCAL_LLM_MODEL sets the default. Input over LOCAL_LLM_MAX_CHARS (24000) is cut.
set -euo pipefail

MODEL="${LOCAL_LLM_MODEL:-general}"
if [[ "${1:-}" == "-m" ]]; then MODEL="${2:?local-llm: -m needs a model}"; shift 2; fi
case "$MODEL" in
  general) MODEL=qwen3.5:4b ;;
  code) MODEL=qwen2.5-coder:3b ;;
  write) MODEL=phi4-mini ;;
esac
URL="${OLLAMA_HOST_URL:-http://127.0.0.1:11434}"
MAX="${LOCAL_LLM_MAX_CHARS:-24000}"

[[ $# -ge 1 ]] || { echo "usage: local-llm [-m general|code|write|<model>] \"<instruction>\" [< input]" >&2; exit 2; }
input=""
# Only a pipe or a file is input: Claude's Bash tool hands an idle socket as stdin, which would block forever.
if [[ -p /dev/stdin || -f /dev/stdin ]]; then input="$(head -c "$MAX")"; fi
prompt="$1"
[[ -z "$input" ]] || prompt="$1

<input>
$input
</input>"

# shortcut: fixed 16k window fits the 4 GB GPU; raise num_ctx with LOCAL_LLM_CTX on a bigger card.
reply="$(jq -nc --arg m "$MODEL" --arg p "$prompt" --argjson c "${LOCAL_LLM_CTX:-16384}" \
  '{model:$m, prompt:$p, stream:false, think:false, options:{num_ctx:$c}}' \
  | curl -fsS --max-time 600 "$URL/api/generate" -d @-)" \
  || { echo "local-llm: Ollama request failed at $URL (is the model pulled? ollama pull $MODEL)" >&2; exit 1; }
jq -r '.response' <<<"$reply"
