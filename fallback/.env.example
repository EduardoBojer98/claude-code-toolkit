# Copy to ~/.config/claude-fallback/.env (install.sh does this) and chmod 600.
# Never commit the real file. Environment variables with the same names take precedence.
# You need at least ONE of these for the fallback to work. All are free to obtain.

# OpenRouter free models: https://openrouter.ai/keys  (20 req/min, 50 req/day on :free models)
OPENROUTER_API_KEY=

# Google Gemini API free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, free TRIAL only (enable [providers.cerebras] in config.toml): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
